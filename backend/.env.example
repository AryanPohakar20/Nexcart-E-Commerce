PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexcart?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_different_from_jwt_secret
REFRESH_TOKEN_EXPIRE=7d
ACCESS_TOKEN_EXPIRE=15m

# Apple Sign-In
APPLE_CLIENT_ID=com.yourapp.bundle.id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email / SMTP (Gmail App Password)
# Use a Gmail App Password (NOT your account password).
# Guide: https://support.google.com/accounts/answer/185833
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Optional: Custom SMTP Server Configuration (if not using Gmail)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
